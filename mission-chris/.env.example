# Veo 3.1 / Gemini (provider principal)
GEMINI_API_KEY=

# Kling 3.0 (provider repli)
KLING_API_KEY=

# Runway (optionnel)
RUNWAY_API_KEY=

# Bridge Vercel : clef interne pour qu'Orion appelle l'endpoint
BRIDGE_API_KEY=

# TikTok Content Posting API (OAuth officiel)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://jet-agent.vercel.app/api/tiktok/oauth?action=callback

# Stockage (choisir Drive ou S3)
STORAGE_BACKEND=s3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Montage : ffmpeg | shotstack | creatomate
MONTAGE_BACKEND=shotstack
SHOTSTACK_API_KEY=
CREATOMATE_API_KEY=

# Notifs
SLACK_WEBHOOK_URL=
WHATSAPP_TO=
